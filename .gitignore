.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local experiment outputs created while running the CLI.
.local_outputs/
tmp_outputs/

# Keep only the curated example artifacts committed in this repository.
outputs/runs/*
!outputs/runs/demonstration_final_h04_dino_bbox/
!outputs/runs/demonstration_final_h04_dino_bbox/**
outputs/evaluations/*
!outputs/evaluations/demonstration_final_matrix/
!outputs/evaluations/demonstration_final_matrix/**

# Model weights are intentionally not stored in git.
*.pt
*.pth
*.onnx
models/

# External datasets are local-only. Keep lightweight provenance/readme files tracked.
data/ocid/raw/
data/ocid/derived/
data/ocid/*.tar.gz

# Editor and OS files.
.idea/
.vscode/
Thumbs.db
.DS_Store
