.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local experiment outputs created while running the CLI.
.local_outputs/
tmp_outputs/

# Keep only deliberately selected example artifacts committed in this repository.
outputs/runs/*
!outputs/runs/README.md
outputs/evaluations/*
!outputs/evaluations/README.md

# Model weights are intentionally not stored in git.
*.pt
*.pth
*.onnx
models/

# External datasets are local-only. Keep lightweight provenance/readme files tracked.
data/ocid/raw/
data/ocid/derived/
data/ocid/*.tar.gz

# Editor and OS files.
.idea/
.vscode/
Thumbs.db
.DS_Store
